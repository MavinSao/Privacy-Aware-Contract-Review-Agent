# All optional — the app runs with none of these set.

# Local model used by the CrewAI privacy chain and available in chat.
OLLAMA_HOST=http://localhost:11434
CREW_MODEL=gemma4:12b

# Set to false to skip CrewAI and run the privacy tools directly.
CREW_ENABLED=true

# Skip pasting keys in the UI. Never commit real keys.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=

# OCR for scanned PDFs and images — point at a separate, fast OCR server (its own
# process/port, can share this venv). Start one with:
#     pip install -r requirements-ocr-server.txt
#     python backend/ocr_server.py --port 10000
# OCR_SERVER_URL=http://127.0.0.1:10000
# OCR_MODEL=Unlimited-OCR
# OCR_PROMPT=document parsing.
# OCR_DPI=300
# OCR_TIMEOUT=120
# OCR runs BEFORE masking, so raw pages must not leave this machine. Non-loopback
# OCR_SERVER_URL values are refused unless you opt in deliberately:
# OCR_ALLOW_REMOTE=false
